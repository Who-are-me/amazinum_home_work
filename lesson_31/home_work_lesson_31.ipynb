    "### home work of lessson 31 by Vasyl Storchak"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "924028cf-1dbc-47b3-9c7e-4c32ef1d2e81",
   "metadata": {},
   "source": [
    "### Dockerfile"
   ]
  },
  {
   "cell_type": "raw",
   "id": "20e01e7d-9c4c-4db0-9c55-2c14ac0327f8",
   "metadata": {},
   "source": [
    "# ---------- Base ----------\n",
    "FROM python:3.12-slim AS base\n",
    "\n",
    "# Avoid interactive prompts\n",
    "ENV DEBIAN_FRONTEND=noninteractive\n",
    "\n",
    "# Set working directory\n",
    "WORKDIR /app\n",
    "\n",
    "# Copy app code\n",
    "COPY . .\n",
    "COPY . /app\n",
    "\n",
    "# Install system dependencies (needed for Pillow, TensorFlow, etc.)\n",
    "RUN apt-get update && apt-get install -y --no-install-recommends \\\n",
    "        build-essential \\\n",
    "        libglib2.0-0 \\\n",
    "        libsm6 \\\n",
    "        libxrender1 \\\n",
    "        libxext6 \\\n",
    "        git \\\n",
    "    && rm -rf /var/lib/apt/lists/*\n",
    "\n",
    "# ---------- Dependencies ----------\n",
    "FROM base AS deps\n",
    "\n",
    "# Copy requirements file first (caching)\n",
    "COPY app/requirements.txt .\n",
    "\n",
    "# Install Python packages\n",
    "RUN pip install --upgrade pip\n",
    "RUN pip install --no-cache-dir -r requirements.txt\n",
    "\n",
    "# ---------- Final ----------\n",
    "FROM base AS final\n",
    "\n",
    "# Copy installed Python packages from deps\n",
    "COPY --from=deps /usr/local/lib/python3.12 /usr/local/lib/python3.12\n",
    "COPY --from=deps /usr/local/bin /usr/local/bin\n",
    "\n",
    "# Expose port\n",
    "EXPOSE 8000\n",
    "\n",
    "# Command to run FastAPI with Uvicorn\n",
    "CMD [\"python\", \"-m\", \"uvicorn\", \"app.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]"
   ]
  },
